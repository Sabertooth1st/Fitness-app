# Public client configuration. Everything prefixed EXPO_PUBLIC_ is embedded in
# the app binary and visible to anyone. Never put a secret here.
# Copy to .env.local (development) or provide through EAS environment variables.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Optional cloud backup. Leave empty to run fully local (guest mode).
EXPO_PUBLIC_SUPABASE_URL=
# The Supabase publishable (client) key. Not the secret/service-role key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RevenueCat public SDK keys. Billing stays off until a paid test is approved.
EXPO_PUBLIC_REVENUECAT_IOS_PUBLIC_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_PUBLIC_KEY=
EXPO_PUBLIC_BILLING_ENABLED=false

# Optional analytics. Off by default; requires explicit user consent in-app.
EXPO_PUBLIC_ANALYTICS_ENABLED=false

# Server-only configuration is documented in docs/ARCHITECTURE.md
# ("Server-only configuration") and lives in Supabase Edge Function secrets,
# never in this file or the mobile binary.
